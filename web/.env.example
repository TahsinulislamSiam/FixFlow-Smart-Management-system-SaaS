# ---------------------------------------------------------------------------
# FixFlow web client environment (Vite reads this from the `web/` folder).
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the FixFlow API.
#   - Local dev: leave EMPTY. Requests hit the relative /api path and the Vite
#     dev server proxies them to http://localhost:4000.
#   - Production (Netlify): set this to the separately-hosted API origin,
#     e.g. https://fixflow-api.onrender.com
VITE_API_URL=
