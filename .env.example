# ---------------------------------------------------------------------------
# FixFlow environment configuration
# Copy this file to `.env` in the project root and adjust as needed.
# Every value below is optional — the app runs with sensible defaults.
# ---------------------------------------------------------------------------

# API server port (the React dev server runs on 5173 and proxies to this)
PORT=4000

# Secret used to sign JWT session tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where the SQLite database file and uploaded photos live
DB_FILE=server/data/fixflow.db
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Optional: plug a real LLM into the AI triage service.
# When empty, FixFlow falls back to its deterministic in-house NLP triage
# engine (`fixflow-triage-v1`), so the demo always works offline.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=9000
