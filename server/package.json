{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FixFlow REST API + realtime gateway (Express, Socket.IO, node:sqlite)",
  "scripts": {
    "dev": "node --experimental-sqlite --watch-path=src src/index.js",
    "start": "node --experimental-sqlite src/index.js",
    "seed": "node --experimental-sqlite src/seed.js",
    "reset": "node --experimental-sqlite src/seed.js --reset",
    "test": "node --experimental-sqlite --test test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  }
}
